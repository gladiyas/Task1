<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Real-Time Weather Dashboard</title>
  <style>
    :root {
      --bg-gradient: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
      --card-bg: rgba(30, 41, 59, 0.7);
      --accent: #38bdf8;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --error-bg: rgba(239, 68, 68, 0.15);
      --error-text: #f87171;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: var(--bg-gradient);
      color: var(--text-main);
      padding: 1.5rem;
    }

    .dashboard-container {
      width: 100%;
      max-width: 500px;
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 2rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    header {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    header h1 {
      font-size: 1.75rem;
      color: var(--accent);
    }

    header p {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-top: 0.25rem;
    }

    .search-box {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .search-box input {
      flex: 1;
      padding: 0.8rem 1rem;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(15, 23, 42, 0.6);
      color: var(--text-main);
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .search-box input:focus {
      border-color: var(--accent);
    }

    .search-box button {
      padding: 0.8rem 1.4rem;
      border: none;
      border-radius: 10px;
      background: var(--accent);
      color: #0f172a;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .search-box button:hover {
      opacity: 0.9;
    }

    .status-message {
      padding: 0.75rem 1rem;
      border-radius: 8px;
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .status-message.error {
      background: var(--error-bg);
      color: var(--error-text);
      border: 1px solid var(--error-text);
    }

    .status-message.info {
      background: rgba(56, 189, 248, 0.15);
      color: var(--accent);
    }

    .weather-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.1);
      padding: 0.2rem 0.5rem;
      border-radius: 6px;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    .weather-icon-condition {
      text-align: right;
    }

    .weather-icon-condition .icon {
      font-size: 2.5rem;
    }

    .weather-icon-condition p {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .primary-metric {
      margin: 1.5rem 0;
      font-size: 3.8rem;
      font-weight: 700;
      line-height: 1;
    }

    .primary-metric .unit {
      font-size: 2rem;
      font-weight: 400;
      color: var(--accent);
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .metric-item {
      background: rgba(15, 23, 42, 0.5);
      padding: 1rem;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .metric-item .label {
      display: block;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 0.3rem;
    }

    .metric-item .value {
      font-size: 1.2rem;
      font-weight: 600;
    }

    .hidden {
      display: none;
    }
  </style>
</head>
<body>
  <div class="dashboard-container">
    <header>
      <h1>Weather Dashboard</h1>
      <p>Live meteorological data via Open-Meteo REST API</p>
    </header>

    <form id="weatherForm" class="search-box">
      <input 
        type="text" 
        id="cityInput" 
        placeholder="Enter city (e.g., Tokyo, London, Paris)..." 
        autocomplete="off" 
        required 
      />
      <button type="submit" id="searchBtn">Search</button>
    </form>

